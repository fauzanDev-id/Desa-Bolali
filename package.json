    "@payloadcms/translations": "3.94.0",
    "@payloadcms/ui": "3.94.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.10.0",
    "lucide-react": "^1.16.0",
    "next": "15.4.11",
    "payload": "3.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
