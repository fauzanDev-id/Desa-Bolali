# Environment Variables Template - Website Desa Bolali
# Salin file ini menjadi .env dan sesuaikan nilainya untuk development/production

# Database PostgreSQL
DATABASE_URI=postgresql://postgres:postgrespassword@127.0.0.1:5433/desa_bolali

# Payload CMS Secret (Gunakan random string yang aman di produksi)
PAYLOAD_SECRET=desa-bolali-secret-key-super-secure-2026

# Public Server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
